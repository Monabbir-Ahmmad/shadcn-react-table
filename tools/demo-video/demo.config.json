  "mailpitUrl": "http://localhost:8025",
  "heroPath": "/",
  "signIn": {
    "path": "/login",
    "emailLabel": "email",
    "passwordLabel": "password",
    "submitButton": "^(sign in|log in)$"
  },
  "hideSelectors": [
    "nextjs-portal",
    "[data-nextjs-toast]",
